# ErrorRelay server configuration (copy to .env or export in your process manager)
PORT=8787
NODE_ENV=production
# token:tenant[:identity],... — generate tokens with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ERRORRELAY_TOKENS=CHANGE_ME_TOKEN:tenant1:user@example
ERRORRELAY_SIGNING_SECRET=CHANGE_ME_64_HEX
# 32-byte key (hex) for AES-256-GCM encryption of attachments at rest (optional but recommended)
ERRORRELAY_BLOB_KEY=
ERRORRELAY_DATA_DIR=/var/lib/errorrelay
# Retention in days for reports and attachments (0 = keep until user deletes)
ERRORRELAY_RETENTION_DAYS=30
# "No-save mode": keep everything in memory only (server restarts wipe data)
ERRORRELAY_NO_SAVE=0
# AI provider (OFF by default). Any OpenAI-compatible chat/completions endpoint with vision.
ERRORRELAY_AI_ENABLED=0
ERRORRELAY_AI_BASE_URL=https://api.openai.com/v1
ERRORRELAY_AI_API_KEY=
ERRORRELAY_AI_MODEL=gpt-5
# Official channel routes (override defaults without a code change)
ERRORRELAY_CHANNELS_FILE=./config/channels.json
# Optional status JSON feed URL — leave empty until a documented public feed is confirmed
ERRORRELAY_STATUS_FEED_URL=
# PWA static files to serve from the same origin
ERRORRELAY_PWA_DIR=./apps/pwa/dist
# Extra CORS origins (only needed when the PWA is hosted on a different origin)
ERRORRELAY_CORS_ORIGINS=
